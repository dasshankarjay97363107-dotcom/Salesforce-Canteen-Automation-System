64.0 APEX_CODE,FINEST;APEX_PROFILING,INFO;CALLOUT,INFO;DATA_ACCESS,INFO;DB,INFO;NBA,INFO;SYSTEM,DEBUG;VALIDATION,INFO;VISUALFORCE,INFO;WAVE,INFO;WORKFLOW,INFO
Execute Anonymous: // Creates the savepoint
Execute Anonymous: Savepoint startPoint = Database.setSavepoint();
Execute Anonymous: 
Execute Anonymous: public class thException extends Exception {}
Execute Anonymous: 
Execute Anonymous: // Creates sample records:
Execute Anonymous: Account parentAccount;
Execute Anonymous: Contact childContact;
Execute Anonymous: 
Execute Anonymous: try {
Execute Anonymous:     parentAccount = new Account(Name = 'TestAccount');
Execute Anonymous:     insert parentAccount;
Execute Anonymous: 
Execute Anonymous:     childContact = new Contact(LastName = 'ChildContact', AccountId = parentAccount.Id);
Execute Anonymous:     insert childContact;
Execute Anonymous:     
Execute Anonymous: } catch(Exception e) {
Execute Anonymous:     throw new thException('GENERIC_APEX_ERROR: ' + e.getMessage());
Execute Anonymous: }
Execute Anonymous: 
Execute Anonymous: Account acctWithContacts = [SELECT Id, (SELECT Id FROM Contacts) FROM Account WHERE Id = :parentAccount.Id]; 
Execute Anonymous: Assert.isTrue(acctWithContacts.contacts.size() > 0, 'Query for acctWithContacts returned no contacts');
Execute Anonymous: 
Execute Anonymous: RestRequest req = new RestRequest(); 
Execute Anonymous: req.requestUri = '/services/apexrest/Accounts/' + acctWithContacts.Id + '/contacts'; 
Execute Anonymous: req.httpMethod = 'GET'; 
Execute Anonymous: RestContext.request = req; 
Execute Anonymous: Account accountFromRestCall = AccountManager.getAccount(); 
Execute Anonymous: 
Execute Anonymous: Map<Id, Contact> contacts = new Map<Id, Contact>([SELECT Id FROM Contact WHERE accountId = :acctWithContacts.Id]); 
Execute Anonymous: Assert.isTrue(contacts.containsKey(accountFromRestCall.contacts[0].Id), 'accountFromRestCall does not return contacts.'); 
Execute Anonymous: 
Execute Anonymous: // clean up, rolling back the savepoint.
Execute Anonymous: Database.rollback(startPoint);
